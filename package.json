{
  "name": "dsh-llm-gateway",
  "version": "0.7.1",
  "description": "Local LLM relay for DeepSeek Harness: merges many OpenAI-compatible upstreams behind one endpoint with automatic failover. Runs in-process, zero runtime dependencies.",
  "license": "MIT",
  "author": "binsonHao",
  "homepage": "https://github.com/binsonHao/dsh-llm-gateway#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binsonHao/dsh-llm-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/binsonHao/dsh-llm-gateway/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm",
    "gateway",
    "openai-compatible",
    "failover"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./patch": "./cordis.patch.yml",
    "./gateway": "./lib/gateway.mjs",
    "./bin": "./bin/gateway.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/gateway.mjs",
    "lib/probe.mjs",
    "bin/gateway.mjs",
    "cordis.patch.yml",
    "channels.example.json",
    "locale/*.json",
    "docs/DETAIL.md",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "render-test.cjs"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "test": "node selftest.mjs"
  },
  "bin": {
    "dsh-llm-gateway": "./bin/gateway.mjs"
  }
}
